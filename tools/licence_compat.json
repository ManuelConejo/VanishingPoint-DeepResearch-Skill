{
 "schema": "vp-licence-compat/1",
 "version": "1",
 "date": "2026-10-31",
 "disclaimer": "Not legal advice: a reading aid built from the licence texts and the positions of the FSF, the OSI and the licence stewards; a lawyer decides. Patent, trademark, export and contributor-agreement questions are outside this table.",
 "direction": "licence-compat <X> <Y>: X = licence of the receiving project (the one that takes code), Y = licence of the code taken from project Y. Rules are written for Y -> X and are not symmetric.",
 "uses": {
  "link": "X uses Y unmodified as a separate library or dependency (imported, linked statically or dynamically) and may distribute it with X",
  "copy": "files or snippets of Y copied unmodified into the source of X",
  "modify": "code of Y copied into X and changed"
 },
 "verdicts": {
  "compatible": "no condition beyond what the licences ask of any distribution",
  "compatible_with_conditions": "allowed when the listed conditions are met",
  "incompatible": "the licences cannot both be honoured for this use while X keeps its licence",
  "unknown": "no rule in this table (or a licence or expression it does not know): nothing is concluded"
 },
 "conditions": {
  "attribution": "keep the copyright notices and the licence text of Y with the code and with any distribution of it",
  "no_endorsement": "do not use the names of Y or of its contributors to endorse or promote X (BSD-3-Clause clause 3)",
  "notice_file": "carry the attribution notices of Y's NOTICE file, if Y has one (Apache-2.0 section 4(d))",
  "state_changes": "modified files carry prominent notices that they were changed (Apache-2.0 section 4(b))",
  "state_changes_if_modified": "when Y's code is modified, modified files carry prominent notices that they were changed (Apache-2.0 section 4(b))",
  "keeps_own_licence": "the code from Y stays under Y's licence inside X: X's licence does not cover those parts",
  "file_level_copyleft": "Y's files and changes to them stay under MPL-2.0 and their source form is made available to recipients (MPL-2.0 sections 3.1, 3.2)",
  "no_secondary_incompatibility": "valid only when Y's files do not carry the \"Incompatible With Secondary Licenses\" notice (MPL-2.0 Exhibit B)",
  "mpl_also_available": "the MPL-covered files stay available under MPL-2.0 as well (MPL-2.0 section 3.3)",
  "lgpl_library": "Y stays under its LGPL: its source (with any change to it) is provided and users may replace or relink it (LGPL-2.1 section 6, LGPL-3.0 section 4)",
  "convert_lgpl21_to_gpl": "the LGPL-2.1 code is conveyed under the GNU GPL, as LGPL-2.1 section 3 permits",
  "combined_under_x": "the combined work is distributed under X's licence, with its complete corresponding source",
  "combined_under_y": "the combined work is distributed under Y's licence (the narrower one), with its complete corresponding source",
  "combined_under_v3": "the combined work is distributed under version 3 of the GNU licence (using an \"or later\" option), with its complete corresponding source",
  "network_source": "users interacting with the program over a network are offered its corresponding source (AGPL-3.0 section 13)"
 },

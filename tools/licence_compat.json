 "rules": [
  {
   "id": "permissive-into-licensed",
   "y": [
    "@notice_permissive"
   ],
   "x": [
    "@all_but_pd"
   ],
   "use": [
    "link",
    "copy",
    "modify"
   ],
   "verdict": "compatible_with_conditions",
   "conditions": [
    "attribution"
   ],
   "sources": [
    "text-mit",
    "text-bsd2",
    "text-isc",
    "fsf-list"
   ],
   "note": "MIT, BSD-2-Clause and ISC ask only that the copyright and permission notice travel with copies; the FSF lists them as GPL-compatible."
  },
  {
   "id": "bsd3-into-licensed",
   "y": [
    "@bsd3"
   ],
   "x": [
    "@all_but_pd"
   ],
   "use": [
    "link",
    "copy",
    "modify"
   ],
   "verdict": "compatible_with_conditions",
   "conditions": [
    "attribution",
    "no_endorsement"
   ],
   "sources": [
    "text-bsd3",
    "fsf-list"
   ],
   "note": "BSD-3-Clause adds the non-endorsement clause; the FSF lists it as GPL-compatible."
  },
  {
   "id": "permissive-into-pd",
   "y": [
    "@notice_permissive"
   ],
   "x": [
    "@public_domain"
   ],
   "use": [
    "link",
    "copy",
    "modify"
   ],
   "verdict": "compatible_with_conditions",
   "conditions": [
    "attribution",
    "keeps_own_licence"
   ],
   "sources": [
    "text-mit",
    "text-bsd2",
    "text-isc",
    "text-unlicense",
    "text-cc0"
   ],
   "note": "A public-domain dedication of X cannot cover code that Y only licensed: those parts keep their notice."
  },
  {
   "id": "bsd3-into-pd",
   "y": [
    "@bsd3"
   ],
   "x": [
    "@public_domain"
   ],
   "use": [
    "link",
    "copy",
    "modify"
   ],
   "verdict": "compatible_with_conditions",
   "conditions": [
    "attribution",
    "no_endorsement",
    "keeps_own_licence"
   ],
   "sources": [

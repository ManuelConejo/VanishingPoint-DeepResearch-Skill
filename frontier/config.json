    "max_files": 200,
    "max_file_bytes": 1000000,
    "max_candidates": 60,
    "max_excerpt_chars": 160
  },
  "matter": {
    "code_plugin": "code",
    "literature_plugin": "cs-ai",
    "min_overlap": 2,
    "max_candidates": 10,
    "timeout_s": 120
  },
  "moment": {

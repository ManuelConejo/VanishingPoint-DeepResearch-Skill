    "window_lines": 3,
    "file_verdict_lines": 80,
    "title_lines": 5,
    "max_block_lines": 30,
    "leak_shingle_words": 5,
    "ignore_dirs": [".git", ".hg", ".svn", "venv", ".venv", "node_modules", "__pycache__", ".tox", ".mypy_cache", ".pytest_cache", "site-packages"],
    "extensions": ["md", "txt", "rst", "py", "json", "yaml", "yml"]

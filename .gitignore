# Python
__pycache__/
*.py[cod]
.pytest_cache/
# Run artefacts (one working directory per question; never commit a run)
state/
!tests/fixtures/*/state/
runs/
*.jsonl
!tests/fixtures/*.jsonl
!tests/fixtures/*/state/*.jsonl
# Frontier test fixtures are recorded working directories: keep their journals
!frontier/tests/fixtures/**/state/
!frontier/tests/fixtures/**/*.jsonl
# Secrets: keys live in ~/.config/vp/ or the environment, never in the repository
*.key
.config/
.env
